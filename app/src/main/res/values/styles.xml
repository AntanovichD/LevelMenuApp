<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.LevelMenuApp" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:windowBackground">@color/calc_bg</item>
    </style>

    <!-- Базовый стиль кнопки калькулятора (одинаковые пропорции для всех экранов) -->
    <style name="CalcButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">0dp</item>
    </style>

    <style name="CalcButton.Digit">
        <item name="android:backgroundTint">@color/calc_digit_bg</item>
        <item name="android:textColor">@color/calc_digit_text</item>
    </style>

    <style name="CalcButton.Op">
        <item name="android:backgroundTint">@color/calc_op_bg</item>
        <item name="android:textColor">@color/calc_op_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CalcButton.Equals">
        <item name="android:backgroundTint">@color/calc_action_bg</item>
        <item name="android:textColor">@color/calc_action_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CalcButton.Clear">
        <item name="android:backgroundTint">@color/calc_clear_bg</item>
        <item name="android:textColor">@color/calc_clear_text</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
