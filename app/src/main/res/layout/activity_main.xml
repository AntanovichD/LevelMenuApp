<?xml version="1.0" encoding="utf-8"?>
<!--
    ЛР №2 (вариант 1) и продолжение в ЛР №3/№4: единственный контейнер — ConstraintLayout.
    Никакие другие ViewGroup (GridLayout/LinearLayout/ScrollView/...) внутри не используются.
    20 кнопок уровней расположены равномерно с помощью горизонтальных и вертикальных цепочек,
    а граница между сеткой уровней и рабочей областью задана горизонтальной Guideline
    (Guideline входит в пакет ConstraintLayout и не является ViewGroup).
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Информационная строка (ЛР №3) -->
    <TextView
        android:id="@+id/tvInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/choose_level"
        android:textSize="18sp"
        android:gravity="center"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Граница: ниже неё расположена «рабочая область» для динамических компонентов (ЛР №4) -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gridBottomGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.62"/>

    <!-- ============ Сетка уровней 5×4 на чистом ConstraintLayout ============ -->
    <!-- Вертикальная цепочка (level_1 → level_5 → level_9 → level_13 → level_17) -->
    <!-- Горизонтальные цепочки в каждой строке: (level_1..level_4), (level_5..level_8), ... -->

    <!-- Row 1 -->
    <Button
        android:id="@+id/level_1"
        android:text="@string/level_1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="6dp"
        android:textSize="18sp"
        android:onClick="onLevelClick"
        app:layout_constraintTop_toBottomOf="@id/tvInfo"
        app:layout_constraintBottom_toTopOf="@id/level_5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/level_2"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintVertical_chainStyle="spread"/>
    <Button
        android:id="@+id/level_2"
        android:text="@string/level_2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="6dp"
        android:textSize="18sp"
        android:onClick="onLevelClick"
        app:layout_constraintTop_toTopOf="@id/level_1"
        app:layout_constraintBottom_toBottomOf="@id/level_1"
        app:layout_constraintStart_toEndOf="@id/level_1"
        app:layout_constraintEnd_toStartOf="@id/level_3"/>
    <Button
        android:id="@+id/level_3"
        android:text="@string/level_3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="6dp"
        android:textSize="18sp"
        android:onClick="onLevelClick"
        app:layout_constraintTop_toTopOf="@id/level_1"
        app:layout_constraintBottom_toBottomOf="@id/level_1"
        app:layout_constraintStart_toEndOf="@id/level_2"
        app:layout_constraintEnd_toStartOf="@id/level_4"/>
    <Button
        android:id="@+id/level_4"
        android:text="@string/level_4"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="6dp"
        android:textSize="18sp"
        android:onClick="onLevelClick"
        app:layout_constraintTop_toTopOf="@id/level_1"
        app:layout_constraintBottom_toBottomOf="@id/level_1"
        app:layout_constraintStart_toEndOf="@id/level_3"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Row 2 -->
    <Button
        android:id="@+id/level_5"
        android:text="@string/level_5"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="6dp"
        android:textSize="18sp"
        android:onClick="onLevelClick"
        app:layout_constraintTop_toBottomOf="@id/level_1"
        app:layout_constraintBottom_toTopOf="@id/level_9"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/level_6"
        app:layout_constraintHorizontal_chainStyle="spread"/>
    <Button
        android:id="@+id/level_6"
        android:text="@string/level_6"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="6dp"
        android:textSize="18sp"
        android:onClick="onLevelClick"
        app:layout_constraintTop_toTopOf="@id/level_5"
        app:layout_constraintBottom_toBottomOf="@id/level_5"
        app:layout_constraintStart_toEndOf="@id/level_5"
        app:layout_constraintEnd_toStartOf="@id/level_7"/>
    <Button
        android:id="@+id/level_7"
        android:text="@string/level_7"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="6dp"
        android:textSize="18sp"
        android:onClick="onLevelClick"
        app:layout_constraintTop_toTopOf="@id/level_5"
        app:layout_constraintBottom_toBottomOf="@id/level_5"
        app:layout_constraintStart_toEndOf="@id/level_6"
        app:layout_constraintEnd_toStartOf="@id/level_8"/>
    <Button
        android:id="@+id/level_8"
        android:text="@string/level_8"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="6dp"
        android:textSize="18sp"
        android:onClick="onLevelClick"
        app:layout_constraintTop_toTopOf="@id/level_5"
        app:layout_constraintBottom_toBottomOf="@id/level_5"
        app:layout_constraintStart_toEndOf="@id/level_7"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Row 3 -->
    <Button
        android:id="@+id/level_9"
        android:text="@string/level_9"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="6dp"
        android:textSize="18sp"
        android:onClick="onLevelClick"
        app:layout_constraintTop_toBottomOf="@id/level_5"
        app:layout_constraintBottom_toTopOf="@id/level_13"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/level_10"
        app:layout_constraintHorizontal_chainStyle="spread"/>
    <Button
        android:id="@+id/level_10"
        android:text="@string/level_10"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="6dp"
        android:textSize="18sp"
        android:onClick="onLevelClick"
        app:layout_constraintTop_toTopOf="@id/level_9"
        app:layout_constraintBottom_toBottomOf="@id/level_9"
        app:layout_constraintStart_toEndOf="@id/level_9"
        app:layout_constraintEnd_toStartOf="@id/level_11"/>
    <Button
        android:id="@+id/level_11"
        android:text="@string/level_11"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="6dp"
        android:textSize="18sp"
        android:onClick="onLevelClick"
        app:layout_constraintTop_toTopOf="@id/level_9"
        app:layout_constraintBottom_toBottomOf="@id/level_9"
        app:layout_constraintStart_toEndOf="@id/level_10"
        app:layout_constraintEnd_toStartOf="@id/level_12"/>
    <Button
        android:id="@+id/level_12"
        android:text="@string/level_12"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="6dp"
        android:textSize="18sp"
        android:onClick="onLevelClick"
        app:layout_constraintTop_toTopOf="@id/level_9"
        app:layout_constraintBottom_toBottomOf="@id/level_9"
        app:layout_constraintStart_toEndOf="@id/level_11"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Row 4 -->
    <Button
        android:id="@+id/level_13"
        android:text="@string/level_13"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="6dp"
        android:textSize="18sp"
        android:onClick="onLevelClick"
        app:layout_constraintTop_toBottomOf="@id/level_9"
        app:layout_constraintBottom_toTopOf="@id/level_17"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/level_14"
        app:layout_constraintHorizontal_chainStyle="spread"/>
    <Button
        android:id="@+id/level_14"
        android:text="@string/level_14"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="6dp"
        android:textSize="18sp"
        android:onClick="onLevelClick"
        app:layout_constraintTop_toTopOf="@id/level_13"
        app:layout_constraintBottom_toBottomOf="@id/level_13"
        app:layout_constraintStart_toEndOf="@id/level_13"
        app:layout_constraintEnd_toStartOf="@id/level_15"/>
    <Button
        android:id="@+id/level_15"
        android:text="@string/level_15"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="6dp"
        android:textSize="18sp"
        android:onClick="onLevelClick"
        app:layout_constraintTop_toTopOf="@id/level_13"
        app:layout_constraintBottom_toBottomOf="@id/level_13"
        app:layout_constraintStart_toEndOf="@id/level_14"
        app:layout_constraintEnd_toStartOf="@id/level_16"/>
    <Button
        android:id="@+id/level_16"
        android:text="@string/level_16"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="6dp"
        android:textSize="18sp"
        android:onClick="onLevelClick"
        app:layout_constraintTop_toTopOf="@id/level_13"
        app:layout_constraintBottom_toBottomOf="@id/level_13"
        app:layout_constraintStart_toEndOf="@id/level_15"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Row 5 -->
    <Button
        android:id="@+id/level_17"
        android:text="@string/level_17"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="6dp"
        android:textSize="18sp"
        android:onClick="onLevelClick"
        app:layout_constraintTop_toBottomOf="@id/level_13"
        app:layout_constraintBottom_toTopOf="@id/gridBottomGuide"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/level_18"
        app:layout_constraintHorizontal_chainStyle="spread"/>
    <Button
        android:id="@+id/level_18"
        android:text="@string/level_18"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="6dp"
        android:textSize="18sp"
        android:onClick="onLevelClick"
        app:layout_constraintTop_toTopOf="@id/level_17"
        app:layout_constraintBottom_toBottomOf="@id/level_17"
        app:layout_constraintStart_toEndOf="@id/level_17"
        app:layout_constraintEnd_toStartOf="@id/level_19"/>
    <Button
        android:id="@+id/level_19"
        android:text="@string/level_19"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="6dp"
        android:textSize="18sp"
        android:onClick="onLevelClick"
        app:layout_constraintTop_toTopOf="@id/level_17"
        app:layout_constraintBottom_toBottomOf="@id/level_17"
        app:layout_constraintStart_toEndOf="@id/level_18"
        app:layout_constraintEnd_toStartOf="@id/level_20"/>
    <Button
        android:id="@+id/level_20"
        android:text="@string/level_20"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="6dp"
        android:textSize="18sp"
        android:onClick="onLevelClick"
        app:layout_constraintTop_toTopOf="@id/level_17"
        app:layout_constraintBottom_toBottomOf="@id/level_17"
        app:layout_constraintStart_toEndOf="@id/level_19"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Подсказка для рабочей области (ЛР №4): обычный View, не ViewGroup -->
    <TextView
        android:id="@+id/workAreaHint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/work_area_hint"
        android:textSize="12sp"
        android:textStyle="italic"
        android:gravity="center"
        android:padding="4dp"
        app:layout_constraintTop_toBottomOf="@id/gridBottomGuide"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Кнопка «Назад» -->
    <Button
        android:id="@+id/btnBack"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/back"
        android:textSize="18sp"
        android:padding="12dp"
        android:onClick="onBackClick"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
