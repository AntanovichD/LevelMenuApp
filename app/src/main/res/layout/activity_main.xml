<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="?attr/actionBarTheme"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/choose_level"
        android:textSize="18sp"
        android:gravity="center"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <GridLayout
        android:id="@+id/gridLevels"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:rowCount="5"
        android:columnCount="4"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvInfo"
        app:layout_constraintBottom_toTopOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button android:text="1" android:layout_width="0dp" android:layout_height="0dp"
            android:layout_rowWeight="1" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:textSize="18sp" android:onClick="onLevelClick"/>
        <Button android:text="2" android:layout_width="0dp" android:layout_height="0dp"
            android:layout_rowWeight="1" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:textSize="18sp" android:onClick="onLevelClick"/>
        <Button android:text="3" android:layout_width="0dp" android:layout_height="0dp"
            android:layout_rowWeight="1" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:textSize="18sp" android:onClick="onLevelClick"/>
        <Button android:text="4" android:layout_width="0dp" android:layout_height="0dp"
            android:layout_rowWeight="1" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:textSize="18sp" android:onClick="onLevelClick"/>
        <Button android:text="5" android:layout_width="0dp" android:layout_height="0dp"
            android:layout_rowWeight="1" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:textSize="18sp" android:onClick="onLevelClick"/>
        <Button android:text="6" android:layout_width="0dp" android:layout_height="0dp"
            android:layout_rowWeight="1" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:textSize="18sp" android:onClick="onLevelClick"/>
        <Button android:text="7" android:layout_width="0dp" android:layout_height="0dp"
            android:layout_rowWeight="1" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:textSize="18sp" android:onClick="onLevelClick"/>
        <Button android:text="8" android:layout_width="0dp" android:layout_height="0dp"
            android:layout_rowWeight="1" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:textSize="18sp" android:onClick="onLevelClick"/>
        <Button android:text="9" android:layout_width="0dp" android:layout_height="0dp"
            android:layout_rowWeight="1" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:textSize="18sp" android:onClick="onLevelClick"/>
        <Button android:text="10" android:layout_width="0dp" android:layout_height="0dp"
            android:layout_rowWeight="1" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:textSize="18sp" android:onClick="onLevelClick"/>
        <Button android:text="11" android:layout_width="0dp" android:layout_height="0dp"
            android:layout_rowWeight="1" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:textSize="18sp" android:onClick="onLevelClick"/>
        <Button android:text="12" android:layout_width="0dp" android:layout_height="0dp"
            android:layout_rowWeight="1" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:textSize="18sp" android:onClick="onLevelClick"/>
        <Button android:text="13" android:layout_width="0dp" android:layout_height="0dp"
            android:layout_rowWeight="1" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:textSize="18sp" android:onClick="onLevelClick"/>
        <Button android:text="14" android:layout_width="0dp" android:layout_height="0dp"
            android:layout_rowWeight="1" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:textSize="18sp" android:onClick="onLevelClick"/>
        <Button android:text="15" android:layout_width="0dp" android:layout_height="0dp"
            android:layout_rowWeight="1" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:textSize="18sp" android:onClick="onLevelClick"/>
        <Button android:text="16" android:layout_width="0dp" android:layout_height="0dp"
            android:layout_rowWeight="1" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:textSize="18sp" android:onClick="onLevelClick"/>
        <Button android:text="17" android:layout_width="0dp" android:layout_height="0dp"
            android:layout_rowWeight="1" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:textSize="18sp" android:onClick="onLevelClick"/>
        <Button android:text="18" android:layout_width="0dp" android:layout_height="0dp"
            android:layout_rowWeight="1" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:textSize="18sp" android:onClick="onLevelClick"/>
        <Button android:text="19" android:layout_width="0dp" android:layout_height="0dp"
            android:layout_rowWeight="1" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:textSize="18sp" android:onClick="onLevelClick"/>
        <Button android:text="20" android:layout_width="0dp" android:layout_height="0dp"
            android:layout_rowWeight="1" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:textSize="18sp" android:onClick="onLevelClick"/>
    </GridLayout>

    <!-- Кнопка Назад -->
    <Button
        android:id="@+id/btnBack"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="Назад"
        android:textSize="18sp"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:onClick="onBackClick"/>
</androidx.constraintlayout.widget.ConstraintLayout>

