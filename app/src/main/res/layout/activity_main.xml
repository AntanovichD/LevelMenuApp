<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/tvInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/choose_level"
        android:textSize="18sp"
        android:gravity="center"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Сетка уровней (ЛР №2, вариант 1: ConstraintLayout + GridLayout) -->
    <GridLayout
        android:id="@+id/gridLevels"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:rowCount="5"
        android:columnCount="4"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvInfo"
        app:layout_constraintBottom_toTopOf="@id/workAreaScroll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_weight="3">

        <Button android:text="@string/level_1"  android:layout_width="0dp" android:layout_height="0dp"
            android:layout_rowWeight="1" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:textSize="18sp" android:onClick="onLevelClick"/>
        <Button android:text="@string/level_2"  android:layout_width="0dp" android:layout_height="0dp"
            android:layout_rowWeight="1" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:textSize="18sp" android:onClick="onLevelClick"/>
        <Button android:text="@string/level_3"  android:layout_width="0dp" android:layout_height="0dp"
            android:layout_rowWeight="1" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:textSize="18sp" android:onClick="onLevelClick"/>
        <Button android:text="@string/level_4"  android:layout_width="0dp" android:layout_height="0dp"
            android:layout_rowWeight="1" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:textSize="18sp" android:onClick="onLevelClick"/>
        <Button android:text="@string/level_5"  android:layout_width="0dp" android:layout_height="0dp"
            android:layout_rowWeight="1" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:textSize="18sp" android:onClick="onLevelClick"/>
        <Button android:text="@string/level_6"  android:layout_width="0dp" android:layout_height="0dp"
            android:layout_rowWeight="1" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:textSize="18sp" android:onClick="onLevelClick"/>
        <Button android:text="@string/level_7"  android:layout_width="0dp" android:layout_height="0dp"
            android:layout_rowWeight="1" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:textSize="18sp" android:onClick="onLevelClick"/>
        <Button android:text="@string/level_8"  android:layout_width="0dp" android:layout_height="0dp"
            android:layout_rowWeight="1" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:textSize="18sp" android:onClick="onLevelClick"/>
        <Button android:text="@string/level_9"  android:layout_width="0dp" android:layout_height="0dp"
            android:layout_rowWeight="1" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:textSize="18sp" android:onClick="onLevelClick"/>
        <Button android:text="@string/level_10" android:layout_width="0dp" android:layout_height="0dp"
            android:layout_rowWeight="1" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:textSize="18sp" android:onClick="onLevelClick"/>
        <Button android:text="@string/level_11" android:layout_width="0dp" android:layout_height="0dp"
            android:layout_rowWeight="1" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:textSize="18sp" android:onClick="onLevelClick"/>
        <Button android:text="@string/level_12" android:layout_width="0dp" android:layout_height="0dp"
            android:layout_rowWeight="1" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:textSize="18sp" android:onClick="onLevelClick"/>
        <Button android:text="@string/level_13" android:layout_width="0dp" android:layout_height="0dp"
            android:layout_rowWeight="1" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:textSize="18sp" android:onClick="onLevelClick"/>
        <Button android:text="@string/level_14" android:layout_width="0dp" android:layout_height="0dp"
            android:layout_rowWeight="1" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:textSize="18sp" android:onClick="onLevelClick"/>
        <Button android:text="@string/level_15" android:layout_width="0dp" android:layout_height="0dp"
            android:layout_rowWeight="1" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:textSize="18sp" android:onClick="onLevelClick"/>
        <Button android:text="@string/level_16" android:layout_width="0dp" android:layout_height="0dp"
            android:layout_rowWeight="1" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:textSize="18sp" android:onClick="onLevelClick"/>
        <Button android:text="@string/level_17" android:layout_width="0dp" android:layout_height="0dp"
            android:layout_rowWeight="1" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:textSize="18sp" android:onClick="onLevelClick"/>
        <Button android:text="@string/level_18" android:layout_width="0dp" android:layout_height="0dp"
            android:layout_rowWeight="1" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:textSize="18sp" android:onClick="onLevelClick"/>
        <Button android:text="@string/level_19" android:layout_width="0dp" android:layout_height="0dp"
            android:layout_rowWeight="1" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:textSize="18sp" android:onClick="onLevelClick"/>
        <Button android:text="@string/level_20" android:layout_width="0dp" android:layout_height="0dp"
            android:layout_rowWeight="1" android:layout_columnWeight="1"
            android:layout_margin="6dp" android:textSize="18sp" android:onClick="onLevelClick"/>
    </GridLayout>

    <!-- Рабочая область для динамических компонентов (ЛР №4) -->
    <ScrollView
        android:id="@+id/workAreaScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:background="#11000000"
        app:layout_constraintTop_toBottomOf="@id/gridLevels"
        app:layout_constraintBottom_toTopOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_weight="1">

        <LinearLayout
            android:id="@+id/workArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/workAreaHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/work_area_hint"
                android:textSize="12sp"
                android:textStyle="italic"
                android:gravity="center"
                android:padding="4dp"/>
        </LinearLayout>
    </ScrollView>

    <!-- Кнопка «Назад» -->
    <Button
        android:id="@+id/btnBack"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/back"
        android:textSize="18sp"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:onClick="onBackClick"/>
</androidx.constraintlayout.widget.ConstraintLayout>
